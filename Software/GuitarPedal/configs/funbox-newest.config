# Effect selection, edited with tools/effects.py (or by hand: ID=y enables an effect). Order and comments do not matter.
# Uranus and the five FunBox effects converted last (Balnea, Pluto, Cassini, Mars, Mercury): light on RAM_D2 and heap. Fits by the estimate; not yet tried on the pedal.
ALLOW_GPL=n
# modulated_tremolo is not set
# overdrive is not set
# autopan is not set
# chorus is not set
# chopper is not set
# reverb is not set
# multi_delay is not set
# metro is not set
# tuner is not set
# pitch_shifter is not set
# compressor is not set
# looper is not set
# geq is not set
# peq is not set
# noise_gate is not set
# cloudseed is not set
# funbox-venus is not set
# funbox-jupiter is not set
# funbox-saturn is not set
# funbox-neptune is not set
funbox-uranus=y
funbox-balnea=y
funbox-pluto=y
funbox-cassini=y
funbox-mars=y
funbox-mercury=y
