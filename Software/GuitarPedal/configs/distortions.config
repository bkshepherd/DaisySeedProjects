# Effect selection, edited with tools/effects.py (or by hand: ID=y enables an effect). Order and comments do not matter.
# All the distortion effects: Distortion, Overdrive, Crusher and the eight new ones (Preamp, Screamer, Muff Fuzz, Wavefolder, Exciter, Bass Dist, Octa Fuzz, Tape Sat).
# Not tried on the pedal.
ALLOW_GPL=n
