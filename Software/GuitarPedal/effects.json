{
 "_note": "Effect manifest read by tools/effects.py. The order of the effects is the order of the effect list in the firmware (it decides the menu order and the layout of the saved settings: changing it resets saved settings on the next boot). 'requires' names components below. Effects with license 'gpl' need ALLOW_GPL=y in the config.",
 "components": {
  "cloudseed_pool": {
   "doc": "The CloudSeed engine's delay line memory (SDRAM), needed by every effect built on the engine; its size follows the number of effects that use it (CLOUDSEED_ENGINES, 1 to 3).",
   "sources": [
    "Effect-Modules/cloudseed_pool.cpp"
   ],
   "count_define": "CLOUDSEED_ENGINES",
   "libs": [
    "dependencies/CloudSeed/build/libcloudseed.a"
   ],
   "measure": "libs"
  },
  "cmsis_fft": {
   "doc": "CMSIS-DSP real FFT (arm_rfft_fast_f32) sources; the tables are chosen per size below.",
   "c_sources": [
    "$(CMSIS_DSP_DIR)/Source/TransformFunctions/arm_rfft_fast_f32.c",
    "$(CMSIS_DSP_DIR)/Source/TransformFunctions/arm_rfft_fast_init_f32.c",
    "$(CMSIS_DSP_DIR)/Source/TransformFunctions/arm_cfft_f32.c",
    "$(CMSIS_DSP_DIR)/Source/TransformFunctions/arm_cfft_init_f32.c",
    "$(CMSIS_DSP_DIR)/Source/TransformFunctions/arm_cfft_radix8_f32.c",
    "$(CMSIS_DSP_DIR)/Source/TransformFunctions/arm_bitreversal2.c",
    "$(CMSIS_DSP_DIR)/Source/CommonTables/arm_common_tables.c",
    "$(CMSIS_DSP_DIR)/Source/CommonTables/arm_const_structs.c"
   ],
   "defines": [
    "-DARM_DSP_CONFIG_TABLES",
    "-DARM_FFT_ALLOW_TABLES"
   ],
   "measure": "manual"
  },
  "cmsis_tables_4096": {
   "doc": "The tables for a 4096-point real FFT (a 2048-point complex FFT plus the real-FFT twiddles): about 36 KB of code space.",
   "defines": [
    "-DARM_TABLE_TWIDDLECOEF_F32_2048",
    "-DARM_TABLE_BITREVIDX_FLT_2048",
    "-DARM_TABLE_TWIDDLECOEF_RFFT_F32_4096"
   ],
   "measure": "manual"
  },
  "cmsis_tables_1024": {
   "doc": "The tables for a 1024-point real FFT.",
   "defines": [
    "-DARM_TABLE_TWIDDLECOEF_F32_512",
    "-DARM_TABLE_BITREVIDX_FLT_512",
    "-DARM_TABLE_TWIDDLECOEF_RFFT_F32_1024"
   ],
   "measure": "manual"
  },
  "dattorro_engine": {
   "doc": "The Dattorro reverb engine (GPL-3.0-or-later).",
   "sources": [
    "Effect-Modules/Dattorro/Dattorro.cpp"
   ],
   "license": "gpl"
  }
 },
